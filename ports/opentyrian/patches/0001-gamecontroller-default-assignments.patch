+// defaults from the SDL game controller mapping: left stick and d-pad move,
+// A fire, B change fire, L1 or X left sidekick, R1 or Y right sidekick,
+// Start menu, Back pause
+static void reset_game_controller_assignments(int j)
+{
+	static const SDL_GameControllerAxis direction_axes[4] =
+	{
+		SDL_CONTROLLER_AXIS_LEFTY, SDL_CONTROLLER_AXIS_LEFTX, SDL_CONTROLLER_AXIS_LEFTY, SDL_CONTROLLER_AXIS_LEFTX
+	};
+	static const SDL_GameControllerButton direction_buttons[4] =
+	{
+		SDL_CONTROLLER_BUTTON_DPAD_UP, SDL_CONTROLLER_BUTTON_DPAD_RIGHT, SDL_CONTROLLER_BUTTON_DPAD_DOWN, SDL_CONTROLLER_BUTTON_DPAD_LEFT
+	};
+	static const SDL_GameControllerButton action_buttons[6][2] =
+	{
+		{ SDL_CONTROLLER_BUTTON_A, SDL_CONTROLLER_BUTTON_INVALID },
+		{ SDL_CONTROLLER_BUTTON_B, SDL_CONTROLLER_BUTTON_INVALID },
+		{ SDL_CONTROLLER_BUTTON_LEFTSHOULDER, SDL_CONTROLLER_BUTTON_X },
+		{ SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, SDL_CONTROLLER_BUTTON_Y },
+		{ SDL_CONTROLLER_BUTTON_START, SDL_CONTROLLER_BUTTON_INVALID },
+		{ SDL_CONTROLLER_BUTTON_BACK, SDL_CONTROLLER_BUTTON_INVALID },
+	};
+	
+	if (!SDL_IsGameController(j))
+		return;
+	
+	SDL_GameController *controller = SDL_GameControllerOpen(j);
+	if (controller == NULL)
+		return;
+	
+	for (uint d = 0; d < COUNTOF(direction_axes); d++)
+	{
+		bool negative = (d == 0 || d == 3);
+		
+		bind_to_assignment(SDL_GameControllerGetBindForAxis(controller, direction_axes[d]), negative, &joystick[j].assignment[d][0]);
+		bind_to_assignment(SDL_GameControllerGetBindForButton(controller, direction_buttons[d]), negative, &joystick[j].assignment[d][1]);
+	}
+	
+	for (uint a = 0; a < COUNTOF(action_buttons); a++)
+	{
+		for (uint i = 0; i < COUNTOF(action_buttons[a]); i++)
+		{
+			if (action_buttons[a][i] == SDL_CONTROLLER_BUTTON_INVALID)
+				joystick[j].assignment[a + 4][i].type = NONE;
+			else
+				bind_to_assignment(SDL_GameControllerGetBindForButton(controller, action_buttons[a][i]), false, &joystick[j].assignment[a + 4][i]);
+		}
+	}
+	
+	SDL_GameControllerClose(controller);
 }
 
 void reset_joystick_assignments(int j)
