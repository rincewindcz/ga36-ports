+static void bind_to_assignment(SDL_GameControllerButtonBind bind, bool negative, Joystick_assignment *assignment)
+{
+	switch (bind.bindType)
+	{
+	case SDL_CONTROLLER_BINDTYPE_BUTTON:
+		assignment->type = BUTTON;
+		assignment->num = bind.value.button;
+		break;
+	case SDL_CONTROLLER_BINDTYPE_AXIS:
+		assignment->type = AXIS;
+		assignment->num = bind.value.axis;
+		assignment->negative_axis = negative;
+		break;
+	case SDL_CONTROLLER_BINDTYPE_HAT:
+		assignment->type = HAT;
+		assignment->num = bind.value.hat.hat;
+		assignment->x_axis = (bind.value.hat.hat_mask & (SDL_HAT_LEFT | SDL_HAT_RIGHT)) != 0;
+		assignment->negative_axis = (bind.value.hat.hat_mask & (SDL_HAT_UP | SDL_HAT_LEFT)) != 0;
+		break;
+	default:
+		assignment->type = NONE;
+		break;
+	}
+}
