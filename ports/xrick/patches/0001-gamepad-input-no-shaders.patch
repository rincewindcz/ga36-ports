+#ifdef ENABLE_JOYSTICK
+static void processEvent();
+
+static S8 stickx = 0, sticky = 0;
+
+/*
+ * Pad input goes through the key path, so that rd2's raw key hook sees it too
+ */
+static void
+padKey(U16 key, U8 down)
+{
+	event.type = down ? SDL_EVENT_KEY_DOWN : SDL_EVENT_KEY_UP;
+	event.key.scancode = (SDL_Scancode)key;
+	event.key.repeat = false;
+	processEvent();
+}
+
+static void
+stickKey(U16 neg, U16 pos, Sint16 value, S8 *state)
+{
+	S8 now = value < -SYSJOY_RANGE ? -1 : value > SYSJOY_RANGE ? 1 : 0;
+
+	if (now == *state)
+		return;
+	if (*state)
+		padKey(*state < 0 ? neg : pos, 0);
+	*state = now;
+	if (now)
+		padKey(now < 0 ? neg : pos, 1);
+}
+
+static U16
+buttonKey(U8 button)
+{
+	switch (button) {
+	case SDL_GAMEPAD_BUTTON_DPAD_UP: return SDL_SCANCODE_UP;
+	case SDL_GAMEPAD_BUTTON_DPAD_DOWN: return SDL_SCANCODE_DOWN;
+	case SDL_GAMEPAD_BUTTON_DPAD_LEFT: return SDL_SCANCODE_LEFT;
+	case SDL_GAMEPAD_BUTTON_DPAD_RIGHT: return SDL_SCANCODE_RIGHT;
+	case SDL_GAMEPAD_BUTTON_SOUTH:
+	case SDL_GAMEPAD_BUTTON_EAST: return syskbd_fire;
+	case SDL_GAMEPAD_BUTTON_START: return syskbd_pause;
+	case SDL_GAMEPAD_BUTTON_BACK: return syskbd_end;
+	default: return 0;
+	}
+}
+#endif
