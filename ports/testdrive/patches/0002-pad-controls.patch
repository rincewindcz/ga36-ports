+/* PORT: the pad acts as the keyboard, so the game's driving and menu code stays as it is. The face buttons
+ * are named as on the console; SDL's mapping of this pad has A south, B east, X west, Y north. */
+enum {
+    PAD_UP = 1, PAD_DOWN = 2, PAD_LEFT = 4, PAD_RIGHT = 8, PAD_SHIFT_UP = 16, PAD_SHIFT_DOWN = 32,
+    PAD_ENTER = 64, PAD_ERASE = 128, PAD_PAUSE = 256, PAD_ESC = 512,
+};
+#define PAD_DIRS   (PAD_UP | PAD_DOWN | PAD_LEFT | PAD_RIGHT)
+#define PAD_STICK  16384
+#define PAD_REPEAT_DELAY_NS (400 * SDL_NS_PER_MS)
+#define PAD_REPEAT_NS       (120 * SDL_NS_PER_MS)
+
+static unsigned pad_held;
+
+static unsigned pad_read(bool driving)
+{
+    if (!gamepad) return 0;
+#define BTN(b) SDL_GetGamepadButton(gamepad, SDL_GAMEPAD_BUTTON_##b)
+    s16 ax = SDL_GetGamepadAxis(gamepad, SDL_GAMEPAD_AXIS_LEFTX);
+    s16 ay = SDL_GetGamepadAxis(gamepad, SDL_GAMEPAD_AXIS_LEFTY);
+    unsigned p = 0;
+    if (BTN(DPAD_LEFT) || ax < -PAD_STICK) p |= PAD_LEFT;
+    if (BTN(DPAD_RIGHT) || ax >= PAD_STICK) p |= PAD_RIGHT;
+    if (BTN(BACK)) p |= PAD_ESC;
+    if (driving) {
+        /* The stick only steers: a slanted stick must not lift off the throttle. */
+        if (BTN(DPAD_UP) || BTN(SOUTH)) p |= PAD_UP;
+        if (BTN(DPAD_DOWN) || BTN(EAST)) p |= PAD_DOWN;
+        if (BTN(RIGHT_SHOULDER) || BTN(WEST)) p |= PAD_SHIFT_UP;
+        if (BTN(LEFT_SHOULDER) || BTN(NORTH)) p |= PAD_SHIFT_DOWN;
+        if (BTN(START)) p |= PAD_PAUSE;
+    } else {
+        if (BTN(DPAD_UP) || ay < -PAD_STICK) p |= PAD_UP;
+        if (BTN(DPAD_DOWN) || ay >= PAD_STICK) p |= PAD_DOWN;
+        if (BTN(SOUTH) || BTN(START)) p |= PAD_ENTER;
+        if (BTN(EAST)) p |= PAD_ERASE;
+    }
+#undef BTN
+    return p;
+}
+
+/* Pressing pushes the key word, so a press shorter than a simulation step counts and menus see it; held
+ * directions repeat in the menus, once the game took the previous one. */
+static void pad_update(void)
+{
+    static const struct { unsigned bit; u16 key; } PAD_KEYS[] = {
+        { PAD_UP, 0x4800 }, { PAD_DOWN, 0x5000 }, { PAD_LEFT, 0x4B00 }, { PAD_RIGHT, 0x4D00 },
+        { PAD_SHIFT_UP, 0x1E61 }, { PAD_SHIFT_DOWN, 0x2C7A }, { PAD_ENTER, 0x1C0D }, { PAD_ERASE, 0x0E08 },
+        { PAD_PAUSE, 0x1970 }, { PAD_ESC, 0x011B },
+    };
+    static Uint64 repeat_ns;
+    bool driving = kb_active();
+    unsigned now = pad_read(driving), pressed = now & ~pad_held;
+    pad_held = now;
+    Uint64 t = SDL_GetTicksNS();
+    if (pressed & PAD_DIRS) repeat_ns = t + PAD_REPEAT_DELAY_NS;
+    if (!driving && (now & PAD_DIRS) && t >= repeat_ns && kbd_head == kbd_tail) {
+        pressed |= now & PAD_DIRS;
+        repeat_ns = t + PAD_REPEAT_NS;
+    }
+    for (size_t i = 0; i < SDL_arraysize(PAD_KEYS); i++)
+        if (pressed & PAD_KEYS[i].bit) kbd_push(PAD_KEYS[i].key);
+}
+
 static bool held_keys = true;
 
