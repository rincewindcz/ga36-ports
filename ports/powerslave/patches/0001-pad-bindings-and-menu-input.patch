+// Menus, intermissions and the demo read the keyboard only. Buttons pressed
+// during play stay out of it, so the one that opens the menu does not also
+// act on it.
+static void HandlePadKeys()
+{
+    static const struct { int button, scan; char ascii; } padKeys[] =
+    {
+        { CONTROLLER_BUTTON_DPAD_UP,    sc_UpArrow,    0 },
+        { CONTROLLER_BUTTON_DPAD_DOWN,  sc_DownArrow,  0 },
+        { CONTROLLER_BUTTON_DPAD_LEFT,  sc_LeftArrow,  0 },
+        { CONTROLLER_BUTTON_DPAD_RIGHT, sc_RightArrow, 0 },
+        { CONTROLLER_BUTTON_A,          sc_Return,     asc_Enter },
+        { CONTROLLER_BUTTON_START,      sc_Return,     asc_Enter },
+        { CONTROLLER_BUTTON_B,          sc_Escape,     asc_Escape },
+    };
+    static int32_t buttonsOld;
+
+    int32_t const buttons = JOYSTICK_GetControllerButtons();
+    bool const inPlay = CONTROL_BindsEnabled && !bInDemo;
+
+    for (auto const &key : padKeys)
+    {
+        int32_t const bit = 1 << key.button;
+
+        if (!((buttons ^ buttonsOld) & bit))
+            continue;
+
+        bool const down = (buttons & bit) && !inPlay;
+        KB_KeyDown[key.scan] = down;
+        if (down && key.ascii && !keyBufferFull())
+            keyBufferInsert(key.ascii);
+    }
+
+    buttonsOld = buttons;
+}
+
 void HandleAsync()
 {
     handleevents();
+    HandlePadKeys();
 }
 
 int MyGetStringWidth(const char *str)
