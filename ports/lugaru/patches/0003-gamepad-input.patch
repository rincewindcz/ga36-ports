+#include <math.h>
+
+using namespace Game;
+
+extern int mainmenu;
+
+#define NUM_KEYS (SDL_NUM_SCANCODES + 6)
+
+bool keyDown[NUM_KEYS];
+bool keyPressed[NUM_KEYS];
+
+static SDL_GameController* pad;
+
+static const float padDeadZone = 0.2f;
+static const float padStickPress = 0.5f;
+static const float padLookSpeed = 450; // mouse pixels per second at full deflection
+
+static SDL_GameController* openPad()
+{
+    if (pad && SDL_GameControllerGetAttached(pad)) {
+        return pad;
+    }
+    if (pad) {
+        SDL_GameControllerClose(pad);
+        pad = nullptr;
+    }
+    if (!SDL_WasInit(SDL_INIT_GAMECONTROLLER)) {
+        SDL_InitSubSystem(SDL_INIT_GAMECONTROLLER);
+    }
+    for (int i = 0; i < SDL_NumJoysticks() && !pad; i++) {
+        if (SDL_IsGameController(i)) {
+            pad = SDL_GameControllerOpen(i);
+        }
+    }
+    return pad;
+}
+
+static float padAxis(SDL_GameControllerAxis axis)
+{
+    float value = SDL_GameControllerGetAxis(pad, axis) / 32767.f;
+    if (fabs(value) < padDeadZone) {
+        return 0;
+    }
+    return value > 0 ? fmin(value, 1) : fmax(value, -1);
+}
+
+static bool padButton(SDL_GameControllerButton button)
+{
+    return SDL_GameControllerGetButton(pad, button);
+}
+
+static void hold(bool* down, int key, bool state)
+{
+    if (key >= 0 && key < NUM_KEYS && state) {
+        down[key] = true;
+    }
+}
+
+/* Pad buttons and the left stick act as the keys bound in the settings */
+static void padKeys(bool* down)
+{
+    const float x = padAxis(SDL_CONTROLLER_AXIS_LEFTX);
+    const float y = padAxis(SDL_CONTROLLER_AXIS_LEFTY);
+    const bool triggerRight = padAxis(SDL_CONTROLLER_AXIS_TRIGGERRIGHT) > padStickPress;
+
+    hold(down, forwardkey, padButton(SDL_CONTROLLER_BUTTON_DPAD_UP) || y < -padStickPress);
+    hold(down, backkey, padButton(SDL_CONTROLLER_BUTTON_DPAD_DOWN) || y > padStickPress);
+    hold(down, leftkey, padButton(SDL_CONTROLLER_BUTTON_DPAD_LEFT) || x < -padStickPress);
+    hold(down, rightkey, padButton(SDL_CONTROLLER_BUTTON_DPAD_RIGHT) || x > padStickPress);
+    hold(down, MOUSEBUTTON_LEFT, padButton(SDL_CONTROLLER_BUTTON_A));
+    hold(down, attackkey, padButton(SDL_CONTROLLER_BUTTON_A));
+    hold(down, jumpkey, padButton(SDL_CONTROLLER_BUTTON_B));
+    hold(down, drawkey, padButton(SDL_CONTROLLER_BUTTON_X));
+    hold(down, throwkey, padButton(SDL_CONTROLLER_BUTTON_Y));
+    hold(down, crouchkey, padButton(SDL_CONTROLLER_BUTTON_RIGHTSHOULDER) || triggerRight);
+    hold(down, SDL_SCANCODE_ESCAPE, padButton(SDL_CONTROLLER_BUTTON_START));
+    hold(down, SDL_SCANCODE_TAB, padButton(SDL_CONTROLLER_BUTTON_BACK));
+}
 
 void Input::Tick()
 {
     SDL_PumpEvents();
