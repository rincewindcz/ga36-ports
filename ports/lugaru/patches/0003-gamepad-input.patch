     int numkeys;
     const Uint8* keyState = SDL_GetKeyboardState(&numkeys);
-    for (int i = 0; i < numkeys; i++) {
-        keyPressed[i] = !keyDown[i] && keyState[i];
-        keyDown[i] = keyState[i];
+    for (int i = 0; i < numkeys && i < SDL_NUM_SCANCODES; i++) {
+        down[i] = keyState[i];
     }
     Uint8 mb = SDL_GetMouseState(NULL, NULL);
     for (int i = 1; i < 6; i++) {
-        keyPressed[SDL_NUM_SCANCODES + i] = !keyDown[SDL_NUM_SCANCODES + i] && (mb & SDL_BUTTON(i));
-        keyDown[SDL_NUM_SCANCODES + i] = (mb & SDL_BUTTON(i));
+        down[SDL_NUM_SCANCODES + i] = (mb & SDL_BUTTON(i));
+    }
+    if (openPad()) {
+        padKeys(down);
+    }
+    for (int i = 0; i < NUM_KEYS; i++) {
+        keyPressed[i] = !keyDown[i] && down[i];
+        keyDown[i] = down[i];
+    }
+}
+
+/* The right stick moves like the mouse; in menus the left stick moves the cursor too */
+void Input::PadMotion(float seconds)
+{
+    if (!openPad()) {
+        return;
+    }
+    float x = padAxis(SDL_CONTROLLER_AXIS_RIGHTX);
+    float y = padAxis(SDL_CONTROLLER_AXIS_RIGHTY);
+    if (mainmenu) {
+        x = fmax(-1, fmin(1, x + padAxis(SDL_CONTROLLER_AXIS_LEFTX)));
+        y = fmax(-1, fmin(1, y + padAxis(SDL_CONTROLLER_AXIS_LEFTY)));
     }
+    deltah += x * fabs(x) * padLookSpeed * seconds;
+    deltav += y * fabs(y) * padLookSpeed * seconds;
 }
 
