+
+/* PORT: the console pad (host.h). SDL's mapping of this pad has A south, B east, X west, Y north. */
+enum {
+    PAD_UP = 1, PAD_DOWN = 2, PAD_RIGHT = 4, PAD_LEFT = 8, PAD_A = 16, PAD_B = 32, PAD_X = 64, PAD_Y = 128,
+    PAD_L1 = 256, PAD_R1 = 512, PAD_START = 1024, PAD_SELECT = 2048, PAD_STICK_UP = 4096, PAD_STICK_DOWN = 8192,
+};
+#define PAD_DIRS  (PAD_UP | PAD_DOWN | PAD_LEFT | PAD_RIGHT | PAD_STICK_UP | PAD_STICK_DOWN)
+#define PAD_STICK 16384
+#define PAD_DRIVE_NS        (250 * SDL_NS_PER_MS)  /* a drive reads the pad every simulation step */
+#define PAD_REPEAT_DELAY_NS (400 * SDL_NS_PER_MS)
+#define PAD_REPEAT_NS       (120 * SDL_NS_PER_MS)
+
+static unsigned pad_held;
+static Uint64 pad_drive_ns;
+
+static unsigned pad_read(void)
+{
+    unsigned p = 0;
+    for (int i = 0; i < PAD_MAX; i++) {
+        SDL_Gamepad *g = pads[i];
+        if (!g) continue;
+#define BTN(b) SDL_GetGamepadButton(g, SDL_GAMEPAD_BUTTON_##b)
+        s16 ax = SDL_GetGamepadAxis(g, SDL_GAMEPAD_AXIS_LEFTX);
+        s16 ay = SDL_GetGamepadAxis(g, SDL_GAMEPAD_AXIS_LEFTY);
+        if (BTN(DPAD_UP)) p |= PAD_UP;
+        if (BTN(DPAD_DOWN)) p |= PAD_DOWN;
+        if (ay < -PAD_STICK) p |= PAD_STICK_UP;
+        if (ay >= PAD_STICK) p |= PAD_STICK_DOWN;
+        if (BTN(DPAD_LEFT) || ax < -PAD_STICK) p |= PAD_LEFT;
+        if (BTN(DPAD_RIGHT) || ax >= PAD_STICK) p |= PAD_RIGHT;
+        if (BTN(SOUTH)) p |= PAD_A;
+        if (BTN(EAST)) p |= PAD_B;
+        if (BTN(WEST)) p |= PAD_X;
+        if (BTN(NORTH)) p |= PAD_Y;
+        if (BTN(LEFT_SHOULDER)) p |= PAD_L1;
+        if (BTN(RIGHT_SHOULDER)) p |= PAD_R1;
+        if (BTN(START)) p |= PAD_START;
+        if (BTN(BACK)) p |= PAD_SELECT;
+#undef BTN
+    }
+    return p;
+}
+
+static bool pad_driving(void) { return pad_drive_ns && SDL_GetTicksNS() - pad_drive_ns < PAD_DRIVE_NS; }
+
+/* presses the XT keys in order and releases them in reverse */
+static void pad_keys(const u8 *xt, int n)
+{
+    if (!scan_handler) return;
+    for (int i = 0; i < n; i++) scan_handler(xt[i]);
+    for (int i = n - 1; i >= 0; i--) scan_handler((u8)(xt[i] | 0x80));
+}
+
+/* A press types its key once; held directions repeat outside a drive. A change between a drive and the
+ * rest counts only new presses, so a button still held from the drive does not answer the next screen. */
+static void pad_update(void)
+{
+    static const struct { unsigned bit; u8 xt; } MENU_KEYS[] = {
+        { PAD_UP | PAD_STICK_UP, 0x48 }, { PAD_DOWN | PAD_STICK_DOWN, 0x50 }, { PAD_LEFT, 0x4B }, { PAD_RIGHT, 0x4D },
+        { PAD_A, 0x1C }, { PAD_START, 0x1C }, { PAD_B, 0x0E }, { PAD_SELECT, 0x01 },
+    };
+    static Uint64 repeat_ns;
+    static bool was_driving;
+    bool driving = pad_driving();
+    unsigned now = pad_read(), pressed = now & ~pad_held;
+    pad_held = now;
+    if (driving != was_driving) {
+        was_driving = driving;
+        return;
+    }
+    if (driving) {
+        static const u8 PAUSE[] = { 0x1D, 0x19 }, ESC[] = { 0x01 };
+        if (pressed & PAD_START) pad_keys(PAUSE, 2);
+        if (pressed & PAD_SELECT) pad_keys(ESC, 1);
+        return;
+    }
+    Uint64 t = SDL_GetTicksNS();
+    if (pressed & PAD_DIRS) repeat_ns = t + PAD_REPEAT_DELAY_NS;
+    else if ((now & PAD_DIRS) && t >= repeat_ns) {
+        pressed |= now & PAD_DIRS;
+        repeat_ns = t + PAD_REPEAT_NS;
+    }
+    for (size_t i = 0; i < SDL_arraysize(MENU_KEYS); i++)
+        if (pressed & MENU_KEYS[i].bit) pad_keys(&MENU_KEYS[i].xt, 1);
+}
+
+u16 host_pad_drive(void)
+{
+    pad_drive_ns = SDL_GetTicksNS();
+    unsigned p = pad_held;                  /* the stick only steers: a slanted stick must not lift off the throttle */
+    u16 r = 0;
+    if (p & (PAD_UP | PAD_A)) r |= 1;
+    if (p & (PAD_DOWN | PAD_B)) r |= 2;
+    if (p & PAD_RIGHT) r |= 4;
+    if (p & PAD_LEFT) r |= 8;
+    if (p & (PAD_R1 | PAD_X)) r |= HOST_PAD_SHIFT_UP;
+    else if (p & (PAD_L1 | PAD_Y)) r |= HOST_PAD_SHIFT_DOWN;
+    return r;
 }
 
