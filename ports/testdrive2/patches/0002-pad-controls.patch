+/* ---- PORT: the pad of the console (every connected gamepad). Outside a drive it types keys through the
+ * scan handler: the directions are the arrows, A and START Enter, B Backspace, SELECT Esc. A drive reads
+ * it with host_pad_drive, which also tells the host that a drive is running: then START is Ctrl-P, SELECT
+ * Esc, and the rest is driving input. The result has the bits of input_drive_bits (1 up, 2 down, 4 right,
+ * 8 left) and a shift button as HOST_PAD_SHIFT_UP / HOST_PAD_SHIFT_DOWN. */
+#define HOST_PAD_SHIFT_UP   0x40
+#define HOST_PAD_SHIFT_DOWN 0x80
+u16 host_pad_drive(void);
+
 /* ---- PC speaker: PIT channel 2 divisor and the port 61h gate (bits 0 and 1 both set = sounding).
  * divisor 0 means 65536. Changes take effect from the current tick onward. */
 void host_speaker(u16 divisor, bool on);
