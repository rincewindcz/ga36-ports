+// True when a quad cannot change the target: fully transparent under an additive-style blend, or outside the clip volume.
+// The Mali-400 spends tens of milliseconds binning huge off-screen quads, and Undertale draws hundreds of them in its late fights.
+static bool quadIsInvisible(GLRenderer* gl, float x0, float y0, float x1, float y1, float x2, float y2, float x3, float y3, uint8_t alpha) {
+    bool blendKeepsTarget = gl->blendEnable && (gl->currentBlendMode == bm_normal || gl->currentBlendMode == bm_add);
+    if (alpha == 0 && blendKeepsTarget && gl->base.currentShader == -1) return true;
+
+    const float* m = gl->base.gmlMatrices[MATRIX_WORLD_VIEW_PROJECTION].m;
+    const float xs[4] = { x0, x1, x2, x3 };
+    const float ys[4] = { y0, y1, y2, y3 };
+    float z = gl->base.drawDepth;
+    int left = 0, right = 0, below = 0, above = 0;
+    for (int i = 0; i < 4; i++) {
+        float cx = m[0] * xs[i] + m[4] * ys[i] + m[8] * z + m[12];
+        float cy = m[1] * xs[i] + m[5] * ys[i] + m[9] * z + m[13];
+        float cw = m[3] * xs[i] + m[7] * ys[i] + m[11] * z + m[15];
+        left += cx < -cw;
+        right += cx > cw;
+        below += cy < -cw;
+        above += cy > cw;
+    }
+    return left == 4 || right == 4 || below == 4 || above == 4;
+}
