+static signed long directionKey(int dx, int dy, boolean menu) {
+    if (dx && dy) {
+        if (menu) return 0;
+        return dy < 0 ? (dx < 0 ? NUMPAD_7 : NUMPAD_9) : (dx < 0 ? NUMPAD_1 : NUMPAD_3);
+    }
+    if (dy < 0) return UP_ARROW;
+    if (dy > 0) return DOWN_ARROW;
+    if (dx < 0) return LEFT_ARROW;
+    if (dx > 0) return RIGHT_ARROW;
+    return 0;
+}
