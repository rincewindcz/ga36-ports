+
+// Moves the focus to the nearest button in the direction (dx, dy). Vertical moves wrap around;
+// horizontal moves without a button on the same row go to the previous or next button.
+static void moveButtonFocus(buttonState *state, int dx, int dy) {
+    const int from = state->buttonFocused;
+    int best = -1;
+    long bestScore = 0;
+
+    if (from < 0 || !buttonIsFocusable(state, from)) {
+        for (int n = 0; n < state->buttonCount; n++) {
+            const int i = (dx < 0 || dy < 0) ? state->buttonCount - 1 - n : n;
+            if (buttonIsFocusable(state, i)) {
+                state->buttonFocused = i;
+                return;
+            }
+        }
+        return;
+    }
+
+    const int fromX = state->buttons[from].x * 2 + strLenWithoutEscapes(state->buttons[from].text);
+    const int fromY = state->buttons[from].y;
+    for (int wrap = 0; wrap < 2 && best < 0; wrap++) {
+        for (int i = 0; i < state->buttonCount; i++) {
+            if (i == from || !buttonIsFocusable(state, i)) {
+                continue;
+            }
+            const int ddx = state->buttons[i].x * 2 + strLenWithoutEscapes(state->buttons[i].text) - fromX;
+            const int ddy = state->buttons[i].y - fromY;
+            long score;
+            if (dy) {
+                if (!wrap && ddy * dy <= 0) {
+                    continue;
+                }
+                // When wrapping, the farthest row in the opposite direction comes first.
+                score = (wrap ? (long) (100 - abs(ddy)) : abs(ddy)) * 1000 + abs(ddx);
+            } else {
+                if (wrap || ddy != 0 || ddx * dx <= 0) {
+                    continue;
+                }
+                score = abs(ddx);
+            }
+            if (best < 0 || score < bestScore) {
+                best = i;
+                bestScore = score;
+            }
+        }
+    }
+    for (int n = 1; best < 0 && dx && n < state->buttonCount; n++) {
+        const int i = (from + dx * n + state->buttonCount * n) % state->buttonCount;
+        if (buttonIsFocusable(state, i)) {
+            best = i;
+        }
+    }
+    if (best >= 0) {
+        state->buttonFocused = best;
+    }
+}
