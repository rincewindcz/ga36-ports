+static void padButton(SDL_GameControllerButton button, boolean down, boolean menu) {
+    switch (button) {
+        case SDL_CONTROLLER_BUTTON_DPAD_UP:    pad.dpad[0] = down; return;
+        case SDL_CONTROLLER_BUTTON_DPAD_DOWN:  pad.dpad[1] = down; return;
+        case SDL_CONTROLLER_BUTTON_DPAD_LEFT:  pad.dpad[2] = down; return;
+        case SDL_CONTROLLER_BUTTON_DPAD_RIGHT: pad.dpad[3] = down; return;
+        case SDL_CONTROLLER_BUTTON_LEFTSHOULDER: pad.l1Held = down; return;
+        default: break;
+    }
+
+    if (button == SDL_CONTROLLER_BUTTON_Y) {
+        if (down) {
+            pad.yHeld = true;
+            pad.ySearched = false;
+            pad.yPressTime = SDL_GetTicks();
+        } else if (pad.yHeld) {
+            pad.yHeld = false;
+            if (!pad.ySearched && !menu) padKey(REST_KEY);
+        }
+        return;
+    }
+
+    if (!down) return;
+
+    switch (button) {
+        case SDL_CONTROLLER_BUTTON_A:
+            if (pad.pointerActive) {
+                queuePointerEvent(MOUSE_DOWN);
+                queuePointerEvent(MOUSE_UP);
+            } else {
+                padKey(RETURN_KEY);
+            }
+            break;
+        case SDL_CONTROLLER_BUTTON_B:             padKey(ESCAPE_KEY); break;
+        case SDL_CONTROLLER_BUTTON_X:             padKey(menu ? 0 : EXPLORE_KEY); break;
+        case SDL_CONTROLLER_BUTTON_START:         padKey(menu ? ESCAPE_KEY : INVENTORY_KEY); break;
+        case SDL_CONTROLLER_BUTTON_BACK:          padKey(menu ? ESCAPE_KEY : ACTION_MENU_KEY); break;
