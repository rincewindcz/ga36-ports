+static void queueEvent(enum eventTypes type, signed long param1, signed long param2) {
+    if (queueCount == EVENT_QUEUE_SIZE) return;
+    rogueEvent *event = &eventQueue[(queueHead + queueCount++) % EVENT_QUEUE_SIZE];
+    *event = (rogueEvent){ .eventType = type, .param1 = param1, .param2 = param2 };
