+static boolean dequeueEvent(rogueEvent *event) {
+    if (queueCount == 0) return false;
+    *event = eventQueue[queueHead];
+    queueHead = (queueHead + 1) % EVENT_QUEUE_SIZE;
+    queueCount--;
+    return true;
+}
