+/// Splits a stick position into one of 8 directions, or 4 if `cardinal`. Returns the deflection
+/// beyond the deadzone (0 .. 1), or 0 inside it.
+static double stickDirection(Sint16 x, Sint16 y, boolean cardinal, int *dx, int *dy) {
+    static const int sectorDx[8] = {1, 1, 0, -1, -1, -1, 0, 1};
+    static const int sectorDy[8] = {0, 1, 1, 1, 0, -1, -1, -1};
+    const double magnitude = sqrt((double)x * x + (double)y * y);
+
+    *dx = *dy = 0;
+    if (magnitude < PAD_STICK_DEADZONE) return 0;
+    if (cardinal) {
+        if (abs(x) > abs(y)) *dx = (x > 0 ? 1 : -1);
+        else *dy = (y > 0 ? 1 : -1);
+    } else {
+        const int sector = (int)lround(atan2(y, x) / (3.14159265358979323846 / 4)) & 7;
+        *dx = sectorDx[sector];
+        *dy = sectorDy[sector];
+    }
+    return min(1.0, (magnitude - PAD_STICK_DEADZONE) / (32767 - PAD_STICK_DEADZONE));
+}
