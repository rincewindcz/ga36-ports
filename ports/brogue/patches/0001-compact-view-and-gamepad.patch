+static void padUpdate(boolean menu, boolean repeat) {
+    const Uint32 now = SDL_GetTicks();
+    int dx, dy;
+
+    if (pad.yHeld && !pad.ySearched && SDL_TICKS_PASSED(now, pad.yPressTime + PAD_SEARCH_HOLD)) {
+        pad.ySearched = true;
+        if (!menu) padKey(SEARCH_KEY);
+    }
+
+    dx = pad.dpad[3] - pad.dpad[2];
+    dy = pad.dpad[1] - pad.dpad[0];
+    if (!dx && !dy) {
+        stickDirection(pad.axis[SDL_CONTROLLER_AXIS_LEFTX], pad.axis[SDL_CONTROLLER_AXIS_LEFTY], menu, &dx, &dy);
+    }
+    if (dx != pad.heldDx || dy != pad.heldDy) {
+        pad.heldDx = dx;
+        pad.heldDy = dy;
+        if (dx || dy) {
+            padKey(directionKey(dx, dy, menu));
+            pad.nextRepeat = now + PAD_REPEAT_DELAY;
+        }
+    } else if ((dx || dy) && repeat && SDL_TICKS_PASSED(now, pad.nextRepeat)) {
+        padKey(directionKey(dx, dy, menu));
+        pad.nextRepeat = now + PAD_REPEAT_INTERVAL;
+    }
+
+    const double deflection = stickDirection(pad.axis[SDL_CONTROLLER_AXIS_RIGHTX], pad.axis[SDL_CONTROLLER_AXIS_RIGHTY],
+                                             false, &dx, &dy);
+    if (!dx && !dy) {
