+// The D-pad works everywhere. In menus A confirms and B goes back; in a race A
+// accelerates, B brakes and Start opens the menu. A release frees the key its
+// press sent, even if a menu opened in between.
+void CanvasImpl::padButton(SDL_GameControllerButton button, bool down)
+{
+    if (button == SDL_CONTROLLER_BUTTON_BACK) {
+        selectHeld = down;
+        return;
+    }
+
+    if (!down) {
+        if (button == SDL_CONTROLLER_BUTTON_B && !padKeys[button]) {
+            canvas->pressedEsc();
+        } else if (padKeys[button]) {
+            canvas->publicKeyReleased(padKeys[button]);
+            padKeys[button] = 0;
+        }
+        return;
+    }
+
+    switch (button) {
+    case SDL_CONTROLLER_BUTTON_DPAD_UP:
+        padKeys[button] = Canvas::Keys::UP;
+        break;
+    case SDL_CONTROLLER_BUTTON_DPAD_DOWN:
+        padKeys[button] = Canvas::Keys::DOWN;
+        break;
+    case SDL_CONTROLLER_BUTTON_DPAD_LEFT:
+        padKeys[button] = Canvas::Keys::LEFT;
+        break;
+    case SDL_CONTROLLER_BUTTON_DPAD_RIGHT:
+        padKeys[button] = Canvas::Keys::RIGHT;
+        break;
+    case SDL_CONTROLLER_BUTTON_A:
+        padKeys[button] = Micro::isInGameMenu ? Canvas::Keys::FIRE : Canvas::Keys::UP;
+        break;
+    case SDL_CONTROLLER_BUTTON_B:
+        padKeys[button] = Micro::isInGameMenu ? 0 : Canvas::Keys::DOWN;
+        break;
+    case SDL_CONTROLLER_BUTTON_START:
+        if (selectHeld) {
+            exit(0);
+        }
+        canvas->pressedEsc();
+        return;
+    default:
+        return;
+    }
+
+    if (padKeys[button]) {
+        canvas->publicKeyPressed(padKeys[button]);
+    }
+}
+
+void CanvasImpl::setStickKey(int slot, int keyCode, bool down)
+{
+    if (down == (stickKeys[slot] != 0)) {
+        return;
+    }
+    stickKeys[slot] = down ? keyCode : 0;
+    if (down) {
+        canvas->publicKeyPressed(keyCode);
+    } else {
+        canvas->publicKeyReleased(keyCode);
+    }
+}
+
+void CanvasImpl::padStick(int axis, int value)
+{
+    if (axis == SDL_CONTROLLER_AXIS_LEFTX) {
+        setStickKey(0, Canvas::Keys::LEFT, value < -STICK_THRESHOLD);
+        setStickKey(1, Canvas::Keys::RIGHT, value > STICK_THRESHOLD);
+    } else if (axis == SDL_CONTROLLER_AXIS_LEFTY) {
+        setStickKey(2, Canvas::Keys::UP, value < -STICK_THRESHOLD);
+        setStickKey(3, Canvas::Keys::DOWN, value > STICK_THRESHOLD);
+    }
+}
