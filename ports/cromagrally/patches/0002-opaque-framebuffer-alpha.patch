+
+	glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_TRUE);
+	glClear(GL_COLOR_BUFFER_BIT);
+	glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+
            /* SWAP THE BUFFS */
 
 	glFlush();										// gl4es draws its pending glBegin/glEnd batch
